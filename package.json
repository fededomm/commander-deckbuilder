{
  "name": "commander-deckbuilder",
  "version": "0.1.0",
  "description": "Costruttore di mazzi Commander con checklist acquisti e prezzi Cardmarket",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.mjs",
    "test": "node test.mjs",
    "symbols": "node symbols.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "it.local.commander-deckbuilder",
    "productName": "Commander Deckbuilder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.mjs",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "dmg": {
      "title": "Commander Deckbuilder"
    }
  }
}
