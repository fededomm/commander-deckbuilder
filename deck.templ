package main

import (
	"net/url"
	"strings"
)

templ deckPage(deck Deck, cards []Card) {
	@layout("Mazzo · " + deck.Name) {
		<div class="deck-page">
			@checklist(deck, cards)
			<aside class="finder" id="finder">
				<h2>
					@iconSearch()
					Cerca carte
				</h2>
				<label class="sr-only" for="q">Cerca su Scryfall</label>
				<input
					id="q"
					name="q"
					placeholder="Sol Ring, t:creature c:g, …"
					autocomplete="off"
					hx-get={ "/deck/" + itoa64(deck.ID) + "/search" }
					hx-trigger="input changed delay:300ms"
					hx-target="#results"
					hx-indicator="#searching"
				/>
				<p id="searching" class="note htmx-indicator" role="status" aria-live="polite">Cerco su Scryfall…</p>
				<p class="hint">
					Vale la sintassi di Scryfall: <code>t:creature</code>, <code>c:g</code>, <code>cmc&lt;=3</code>.
				</p>
				<div id="results"></div>
			</aside>
		</div>
		<img id="preview" alt="" hidden/>
		// Una sola dialog per pagina, riempita da htmx. È l'elemento nativo:
		// backdrop, Esc e focus trap li porta il browser.
		<dialog id="prints" aria-labelledby="prints-title"></dialog>
	}
}

// checklist è il pezzo che htmx rimpiazza a ogni modifica: intestazione, statistiche
// e righe. L'intestazione sta dentro perché i totali cambiano a ogni spunta.
templ checklist(deck Deck, cards []Card) {
	{{ total := qty(cards) }}
	<div id="checklist" hx-target="this" hx-swap="outerHTML">
		<header class="deck-bar">
			<a class="crumb" href="/">
				@iconBack()
				Tutti i mazzi
			</a>
			<div class="deck-id">
				<h1>{ deck.Name }</h1>
				@pips(deckColors(cards))
			</div>
			if total > 0 {
				@deckCounts(cards, false)
			}
			<div class="deck-actions">
				<a class="btn-ghost only-narrow" href="#finder">
					@iconPlus()
					Aggiungi
				</a>
				<button
					id="refresh"
					class="btn-ghost"
					aria-label="Riallinea i prezzi a Scryfall"
					hx-post={ "/deck/" + itoa64(deck.ID) + "/prices" }
					hx-disabled-elt="this"
				>
					@iconRefresh()
					Prezzi
				</button>
				<a
					id="export"
					class="btn-ghost"
					href={ "/deck/" + itoa64(deck.ID) + "/export" }
					aria-label="Scarica il mazzo in formato Moxfield"
				>
					@iconDownload()
					Esporta
				</a>
			</div>
		</header>
		if total == 0 {
			<p class="empty-state">
				<strong>Il mazzo è vuoto.</strong>
				Cerca una carta nel pannello di ricerca e clicca il risultato per aggiungerla.
			</p>
		} else {
			@deckStats(cards, false)
			<div id="deck-tools" class="deck-tools" hx-preserve="true">
				// Casella "tutte": agisce solo sulle righe visibili, cioè su quelle
				// che il filtro lascia passare. Lo stato lo tiene aggiornato app.js.
				<label class="check-box" title="Seleziona tutte le carte visibili">
					<input
						id="check-all"
						class="check"
						type="checkbox"
						aria-label="Segna come acquistate tutte le carte visibili"
						data-url={ "/deck/" + itoa64(deck.ID) + "/purchased" }
						hx-sync="#deck:queue all"
					/>
				</label>
				<label class="sr-only" for="filter">Filtra le carte del mazzo</label>
				<div class="icon-field">
					@iconSearch()
					<input id="filter" type="search" placeholder="Filtra per nome o tipo" autocomplete="off"/>
				</div>
			</div>
			<div id="deck">
				for _, g := range groupByCategory(cards) {
					<section>
						<h3>
							{ g.Name }
							<span>{ itoa(g.Qty) } · { eur(g.Total) }</span>
						</h3>
						for _, c := range g.Cards {
							@cardRow(c)
						}
					</section>
				}
				<p id="filter-empty" class="empty-state" hidden>Nessuna carta del mazzo corrisponde al filtro.</p>
			</div>
		}
	</div>
}

// deckCounts e deckStats sono le parti della checklist che dipendono dalle spunte.
// Con oob tornano da sole, out-of-band, dopo ogni spunta: le righe restano ferme.
templ deckCounts(cards []Card, oob bool) {
	<p
		id="deck-counts"
		class="deck-counts"
		if oob {
			hx-swap-oob="true"
		}
	>
		<strong>{ itoa(purchasedQty(cards)) }/{ itoa(qty(cards)) }</strong> acquistate
		<span class="sep">·</span>
		<strong>{ eur(totals(cards).Total) }</strong>
	</p>
}

templ deckStats(cards []Card, oob bool) {
	{{ t := totals(cards) }}
	{{ bought, total := purchasedQty(cards), qty(cards) }}
	<section
		id="deck-stats"
		class="deck-stats"
		aria-label="Statistiche del mazzo"
		if oob {
			hx-swap-oob="true"
		}
	>
		<div class="figures">
			<div class="figure wide">
				<dt>Avanzamento acquisti</dt>
				<dd>
					{ itoa(pct(bought, total)) }%
					<span class="progress" aria-hidden="true">
						<span style={ barWidth(pct(bought, total)) }></span>
					</span>
				</dd>
			</div>
			<div class="figure">
				<dt>Da comprare</dt>
				<dd>{ eur(t.Todo) }</dd>
			</div>
			<div class="figure">
				<dt>Valore totale</dt>
				<dd>{ eur(t.Total) }</dd>
			</div>
			if t.Unpriced > 0 {
				<div class="figure">
					<dt>Senza quotazione</dt>
					<dd>{ itoa(t.Unpriced) }</dd>
				</div>
			}
		</div>
		@manaCurveChart(cards)
		@colorSpread(cards)
	</section>
}

templ purchaseStats(cards []Card) {
	@deckCounts(cards, true)
	@deckStats(cards, true)
}

// manaCurveChart: barre in CSS puro, nessuna libreria. aria-label porta gli stessi
// numeri a chi il grafico non lo vede.
templ manaCurveChart(cards []Card) {
	{{ bars := manaCurve(cards) }}
	if len(bars) > 0 {
		<figure class="curve-box">
			<figcaption>Curva di mana <small>(terre escluse)</small></figcaption>
			<div class="curve" role="img" aria-label={ curveLabel(bars) }>
				for _, b := range bars {
					<div class="curve-col">
						<span class="curve-n">
							if b.Qty > 0 {
								{ itoa(b.Qty) }
							}
						</span>
						<span class="curve-track">
							<span class="curve-bar" style={ barHeight(b.Pct) }></span>
						</span>
						<span class="curve-x">{ b.Label }</span>
					</div>
				}
			</div>
		</figure>
	}
}

// colorSpread: quante carte per colore. Una multicolore conta in ogni suo colore.
templ colorSpread(cards []Card) {
	{{ stats := colorStats(cards) }}
	if len(stats) > 0 {
		<figure class="colors-box">
			<figcaption>Colori</figcaption>
			<ul class="colors">
				for _, s := range stats {
					<li>
						<span class={ "pip", "pip-" + s.Code } aria-hidden="true"></span>
						{ s.Name }
						<b>{ itoa(s.Qty) }</b>
					</li>
				}
			</ul>
		</figure>
	}
}

templ cardRow(c Card) {
	<div class="row">
		// label attorno alla casella: l'area cliccabile arriva a 44px senza
		// ingrassare la casella stessa
		<label class="check-box">
			<input
				class="check"
				type="checkbox"
				checked?={ c.Purchased }
				name="purchased"
				value="1"
				data-id={ itoa64(c.ID) }
				aria-label={ "Acquistata: " + c.Name }
				hx-post={ "/deck/" + itoa64(c.DeckID) + "/purchased" }
				hx-vals={ `{"ids":"` + itoa64(c.ID) + `"}` }
				hx-swap="none"
				hx-sync="#deck:queue all"
			/>
		</label>
		if c.Image != "" {
			<img
				class="thumb zoom"
				src={ thumbURL(c.Image) }
				alt=""
				loading="lazy"
				data-preview={ c.Image }
				data-preview-alt={ c.Name }
			/>
		} else {
			<span class="thumb"></span>
		}
		<span
			class={ "name", templ.KV("zoom", c.Image != "") }
			title={ c.TypeLine }
			data-preview={ c.Image }
			data-preview-alt={ c.Name }
		>
			if c.Qty > 1 {
				<span class="qty">{ itoa(c.Qty) }×</span>
			}
			{ c.Name }
			if c.Foil {
				<span class="foil" title="Foil" aria-label="foil">✦</span>
			}
		</span>
		if c.SetCode != "" {
			<span class="set" title="Espansione e numero di collezione">
				{ strings.ToUpper(c.SetCode) }
				<span class="set-num">{ c.CollectorNumber }</span>
			</span>
		}
		<span class="cost mana">
			@mana(c.ManaCost)
		</span>
		<span class="cost price">{ price0(c.PriceEUR) }</span>
		<button
			class="icon-btn danger"
			aria-label={ "Rimuovi " + c.Name + " dal mazzo" }
			title="Rimuovi"
			hx-delete={ "/cards/" + itoa64(c.ID) }
		>
			@iconTrash()
		</button>
	</div>
}

templ mana(cost string) {
	for _, p := range manaParts(cost) {
		if p.SVG != "" {
			<img class="sym" src={ "/static/symbols/" + p.SVG } alt={ p.Text } loading="lazy"/>
		} else {
			{ p.Text }
		}
	}
}

templ searchResults(deckID int64, cards []scryCard, err error) {
	if err != nil {
		<p class="note error">{ err.Error() }</p>
	} else if len(cards) == 0 {
		<p class="note">Nessuna carta trovata.</p>
	} else {
		for _, c := range cards {
			<div class="hit-box">
				<button
					class="hit"
					hx-post={ "/deck/" + itoa64(deckID) + "/cards" }
					hx-vals={ scryVals(c.ID) }
					hx-target="#checklist"
					hx-swap="outerHTML"
				>
					<img src={ c.image() } alt="" loading="lazy"/>
					<span class="hit-text">
						<strong>{ c.Name }</strong>
						<small>{ c.TypeLine }</small>
					</span>
					<span class="cost price">{ price0(c.price(false)) }</span>
				</button>
				<button
					class="prints-btn"
					hx-get={ printsURL(deckID, c) }
					hx-target="#prints"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
				>
					@iconLayers()
					Altre stampe
					<span class="set">
						{ strings.ToUpper(c.Set) }
						<span class="set-num">{ c.CollectorNumber }</span>
					</span>
				</button>
			</div>
		}
	}
}

// printsDialog: intestazione, griglia di ristampe e paginazione. Il contenuto
// della dialog, non la dialog stessa — quella sta già nella pagina.
templ printsDialog(deckID int64, name string, p Page, query url.Values, err error) {
	<header class="dialog-head">
		<div>
			<h2 id="prints-title">Stampe di { name }</h2>
			if err == nil && p.Total > 0 {
				<p class="note">{ itoa(p.Total) } ristampe, dalla più economica</p>
			}
		</div>
		// form method="dialog": chiude senza una riga di JS
		<form method="dialog">
			<button class="icon-btn" aria-label="Chiudi le stampe">
				@iconClose()
			</button>
		</form>
	</header>
	if err != nil {
		<p class="note error">{ err.Error() }</p>
	} else if p.Total == 0 {
		<p class="note">Nessuna ristampa trovata.</p>
	} else {
		<div class="prints-grid">
			for _, c := range p.Items {
				@printCard(deckID, c)
			}
		</div>
		@pager(deckID, p, query)
	}
}

// printCard è una ristampa nella griglia: cliccarla mette nel mazzo quella
// stampa lì — il server rilegge la carta dall'id, come per la ricerca.
templ printCard(deckID int64, c scryCard) {
	<button
		class="print"
		aria-label={ "Aggiungi " + c.Name + " — edizione " + c.SetName }
		hx-post={ "/deck/" + itoa64(deckID) + "/cards" }
		hx-vals={ scryVals(c.ID) }
		hx-target="#checklist"
		hx-swap="outerHTML"
	>
		<img src={ thumbURL(c.image()) } alt="" loading="lazy"/>
		<span class="print-set">
			{ strings.ToUpper(c.Set) } { c.CollectorNumber }
		</span>
		<span class="print-name">{ c.SetName }</span>
		<span class="print-foot">
			<span>{ printYear(c.ReleasedAt) }</span>
			<b class="price">{ price0(c.price(false)) }</b>
		</span>
	</button>
}

templ pager(deckID int64, p Page, query url.Values) {
	if p.Count > 1 {
		<nav class="pager" aria-label="Pagine delle ristampe">
			<button
				class="btn-ghost"
				disabled?={ p.Num <= 1 }
				aria-label="Pagina precedente"
				hx-get={ pageURL(query, deckID, p.Num-1) }
				hx-target="#prints"
				hx-swap="innerHTML"
			>
				@iconBack()
				Indietro
			</button>
			<span class="note" role="status" aria-live="polite">Pagina { itoa(p.Num) } di { itoa(p.Count) }</span>
			<button
				class="btn-ghost"
				disabled?={ p.Num >= p.Count }
				aria-label="Pagina successiva"
				hx-get={ pageURL(query, deckID, p.Num+1) }
				hx-target="#prints"
				hx-swap="innerHTML"
			>
				Avanti
				<span class="flip">
					@iconBack()
				</span>
			</button>
		</nav>
	}
}
