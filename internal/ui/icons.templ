package ui

// Icone Lucide (lucide.dev, licenza ISC) ridisegnate come componenti: stesso
// viewBox 24×24 e stesso tratto per tutte, così restano allineate ovunque.
// Sono decorative — l'etichetta sta sempre sul pulsante che le contiene.

templ icon(path templ.Component) {
	<svg
		class="icon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		focusable="false"
	>
		@path
	</svg>
}

templ iconTrash() {
	@icon(trashPath())
}

templ trashPath() {
	<path d="M3 6h18"></path>
	<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
	<path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
	<path d="M10 11v6"></path>
	<path d="M14 11v6"></path>
}

templ iconRefresh() {
	@icon(refreshPath())
}

templ refreshPath() {
	<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
	<path d="M21 3v5h-5"></path>
	<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
	<path d="M8 16H3v5"></path>
}

