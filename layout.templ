package main

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="it">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Costruisci mazzi Commander, tieni la lista della spesa e i prezzi Cardmarket aggiornati."/>
			<meta name="theme-color" content="#0b0a0f"/>
			<title>{ title }</title>
			<link rel="icon" href="/static/icon.png" type="image/png"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			{ children... }
			@legal()
		</body>
	</html>
}

// legal: la dicitura richiesta dalla Fan Content Policy di Wizards, più
// l'attribuzione a Scryfall da cui arrivano dati, immagini e prezzi.
// Il testo Wizards è quello ufficiale: va lasciato in inglese e alla lettera.
templ legal() {
	<footer class="legal">
		<p>
			commander-deckbuilder is unofficial Fan Content permitted under the
			<a href="https://company.wizards.com/en/legal/fancontentpolicy" target="_blank" rel="noopener noreferrer">Fan Content Policy</a>.
			Not approved/endorsed by Wizards. Portions of the materials used are property of
			Wizards of the Coast. ©Wizards of the Coast LLC.
		</p>
		<p>
			Dati, immagini e simboli delle carte da
			<a href="https://scryfall.com" target="_blank" rel="noopener noreferrer">Scryfall</a>;
			prezzi Cardmarket forniti tramite Scryfall. Nessuno dei due approva o sponsorizza questa app.
		</p>
	</footer>
}

// pips: i pallini dell'identità di colore, es. "WUB". Vuoto se il mazzo è incolore,
// così non resta un buco nel layout.
templ pips(colors string) {
	if colors != "" {
		<span class="pips" title={ colorName(colors) } aria-label={ "Colori: " + colorName(colors) } role="img">
			for _, c := range colors {
				<span class={ "pip", "pip-" + string(c) }></span>
			}
		</span>
	}
}
